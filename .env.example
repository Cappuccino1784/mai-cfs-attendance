# Set these in Vercel Dashboard -> Settings -> Environment Variables.
# Create a Turso database and a Vercel Blob store, then copy their credentials here.
TURSO_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token
BLOB_READ_WRITE_TOKEN=your-vercel-blob-read-write-token

# Optional: only needed if frontend and API are on different domains.
# When deployed together on the same Vercel project, leave this empty.
VITE_API_URL=


