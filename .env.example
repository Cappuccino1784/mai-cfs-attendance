# Set these in Vercel Dashboard -> Settings -> Environment Variables.
# Create a Supabase project and a Vercel Blob store, then copy their credentials here.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Optional: only needed if frontend and API are on different domains.
# When deployed together on the same Vercel project, leave this empty.
VITE_API_URL=



